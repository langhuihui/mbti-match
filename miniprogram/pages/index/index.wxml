<!-- pages/index/index.wxml -->
<view class="page">
  <!-- Hero 区域 -->
  <view class="hero" style="padding-top: {{statusBarHeight + 20}}px;">
    <view class="hero-orb orb-1"></view>
    <view class="hero-orb orb-2"></view>

    <!-- Logo -->
    <view class="hero-content">
      <view class="logo-area">
        <view class="logo-icon-wrap">
          <text class="logo-letter">M</text>
        </view>
        <text class="logo-text">MBTI Match</text>
      </view>
      <text class="hero-title">发现你的认知密码</text>
      <text class="hero-subtitle">通过 AI 对话，从你的真实故事中解读荣格八维认知功能</text>
    </view>

    <!-- 主操作区 -->
    <view class="hero-actions">
      <!-- 已测定：显示结果摘要 + 重新测定 -->
      <button class="btn-hero-primary" bindtap="goChatAssessment" wx:if="{{myType}}">
        <view class="btn-text-group">
          <text class="btn-main-text">重新测定</text>
          <text class="btn-sub-text">再聊一次，看看有没有新的发现</text>
        </view>
      </button>

      <!-- 未测定：主入口 -->
      <button class="btn-hero-primary" bindtap="goChatAssessment" wx:else>
        <view class="btn-text-group">
          <text class="btn-main-text">开始对话测定</text>
          <text class="btn-sub-text">和 AI 聊聊你的故事，大约 10-15 分钟</text>
        </view>
      </button>

      <!-- 已测定：查看结果 -->
      <button class="btn-hero-secondary" bindtap="goResult" wx:if="{{myType}}">
        <view class="btn-text-group">
          <text class="btn-main-text">查看我的结果</text>
          <text class="btn-sub-text">八维功能排序与成长建议</text>
        </view>
      </button>
    </view>

    <!-- 已测定结果卡片 -->
    <view class="result-card" wx:if="{{myType}}" bindtap="goResult">
      <view class="result-card-left">
        <text class="result-type">{{myType}}</text>
        <text class="result-name">{{myTypeInfo.name}}</text>
      </view>
      <view class="result-card-right">
        <text class="result-motto">{{myTypeInfo.motto}}</text>
      </view>
    </view>
  </view>

  <!-- 功能说明区 -->
  <view class="features-section">
    <text class="section-title">这是怎样的一次测定？</text>
    <view class="feature-list">
      <view class="feature-item">
        <view class="feature-icon icon-chat"></view>
        <view class="feature-text">
          <text class="feature-title">不是做题，是聊天</text>
          <text class="feature-desc">没有选择题，只需要聊聊最近的生活</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon icon-brain"></view>
        <view class="feature-text">
          <text class="feature-title">荣格八维 + 九型人格</text>
          <text class="feature-desc">双框架分析，看透你的思维方式</text>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon icon-shield"></view>
        <view class="feature-text">
          <text class="feature-title">安全且温暖</text>
          <text class="feature-desc">随时可暂停，你的数据只属于你</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-padding"></view>
</view>
