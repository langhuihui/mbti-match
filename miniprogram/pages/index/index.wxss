/* pages/index/index.wxss - 测定工具首页 */

.page {
  min-height: 100vh;
  background: #f8f6f3;
}

/* === Hero === */
.hero {
  position: relative;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 40%, #6366f1 100%);
  padding-bottom: 60rpx;
  overflow: hidden;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.3;
}

.orb-1 {
  width: 300rpx;
  height: 300rpx;
  background: #6366f1;
  top: 100rpx;
  right: -50rpx;
}

.orb-2 {
  width: 200rpx;
  height: 200rpx;
  background: #ec4899;
  bottom: 100rpx;
  left: -30rpx;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.logo-area {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border: 1px solid rgba(255,255,255,0.2);
}

.logo-letter {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.logo-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  padding: 0 60rpx;
  line-height: 1.6;
}

/* === 操作按钮 === */
.hero-actions {
  position: relative;
  z-index: 2;
  padding: 40rpx 48rpx 0;
}

.btn-hero-primary {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  margin-bottom: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(99,102,241,0.3);
}

.btn-hero-primary::after {
  border: none;
}

.btn-hero-secondary {
  width: 100%;
  background: rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 28rpx 40rpx;
  border: 1px solid rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hero-secondary::after {
  border: none;
}

.btn-text-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-main-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.btn-hero-secondary .btn-main-text {
  color: #fff;
}

.btn-sub-text {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.btn-hero-secondary .btn-sub-text {
  color: rgba(255,255,255,0.6);
}

/* === 结果卡片 === */
.result-card {
  position: relative;
  z-index: 2;
  margin: 20rpx 48rpx 0;
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid rgba(255,255,255,0.15);
}

.result-card-left {
  display: flex;
  flex-direction: column;
}

.result-type {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.result-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
}

.result-card-right {
  flex: 1;
  margin-left: 30rpx;
}

.result-motto {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
  text-align: right;
}

/* === 功能说明 === */
.features-section {
  padding: 48rpx 48rpx 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 32rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-chat {
  background: linear-gradient(135deg, #6366f1, #818cf8);
}

.icon-brain {
  background: linear-gradient(135deg, #ec4899, #f472b6);
}

.icon-shield {
  background: linear-gradient(135deg, #10b981, #34d399);
}

.feature-text {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.bottom-padding {
  height: 120rpx;
}
