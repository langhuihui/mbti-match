/* 发布笔记页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.nav-publish {
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
  background: #e2e8f0;
}

.nav-publish.active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.3);
}

.publish-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #94a3b8;
}

.nav-publish.active .publish-text {
  color: #fff;
}

.content {
  height: calc(100vh - env(safe-area-inset-bottom));
}

/* ====== 表单区域 ====== */
.form-section {
  padding: 24rpx 32rpx;
  margin-bottom: 8rpx;
  background: #fff;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #ef4444;
}

.input-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.input-count.over {
  color: #ef4444;
}

.input-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.title-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

.content-input {
  width: 100%;
  min-height: 300rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

/* ====== 图片上传 ====== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.image-delete {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ef4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-x {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 3rpx dashed #d1d5db;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #9ca3af;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ====== 话题选择 ====== */
.topic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.topic-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  border: 2rpx solid transparent;
}

.topic-chip.active {
  background: rgba(99, 102, 241, 0.08);
  border-color: var(--primary);
}

.topic-chip-icon {
  font-size: 24rpx;
}

.topic-chip-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.topic-chip.active .topic-chip-name {
  color: var(--primary);
}

/* ====== 标签选择 ====== */
.tag-group {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.tag-group-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-chip {
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  border: 2rpx solid transparent;
}

.tag-chip.active {
  background: rgba(99, 102, 241, 0.08);
  border-color: var(--primary);
}

.tag-chip-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tag-chip.active .tag-chip-text {
  color: var(--primary);
  font-weight: 600;
}

.custom-tag-area {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.custom-tag-input {
  flex: 1;
  height: 68rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
}

.custom-tag-btn {
  width: 120rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  padding: 0;
  line-height: normal;
}

.custom-tag-btn::after {
  border: none;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.selected-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.selected-tag {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}
