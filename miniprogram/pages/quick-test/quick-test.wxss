.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1e1b4b 0%, #312e81 200rpx, var(--bg) 500rpx);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 64rpx;
}

.content {
  padding: 0 32rpx 64rpx;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #818cf8, #c084fc);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 40rpx;
}

.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.question-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  transition: all 0.2s;
}

.option-btn.selected {
  border-color: #6366f1;
  background: #eef2ff;
}

.option-label {
  font-size: 30rpx;
  color: #334155;
  line-height: 1.4;
}

.hint-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 32rpx;
}

.result-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.result-avatar {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}

.result-type {
  font-size: 56rpx;
  font-weight: 700;
  color: #6366f1;
  letter-spacing: 4rpx;
}

.result-name {
  font-size: 32rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.result-badge {
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
}

.result-motto {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #475569;
  text-align: center;
  font-style: italic;
}

.quick-tag {
  margin-top: 24rpx;
  padding: 8rpx 20rpx;
  background: #fef3c7;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #92400e;
}

.result-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.action-area {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx;
}

.btn-secondary {
  background: #fff;
  color: #6366f1;
  border: 2rpx solid #6366f1;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx;
}

.btn-text {
  background: transparent;
  color: #94a3b8;
  border: none;
  font-size: 28rpx;
}
