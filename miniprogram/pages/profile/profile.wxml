<!-- pages/profile/profile.wxml -->
<view class="page">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{headerHeight - statusBarHeight}}px;">
      <text class="nav-title">我的</text>
    </view>
  </view>

  <view class="content" style="padding-top: {{headerHeight + 16}}px;">
    <!-- 用户信息卡片 -->
    <view class="profile-card">
      <view class="profile-main" bindtap="showProfileSetup">
        <image class="profile-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.svg'}}" mode="aspectFill" />
        <view class="profile-info">
          <text class="profile-name">{{userInfo.nickname || '点击设置昵称'}}</text>
          <view class="profile-type-row" wx:if="{{myType}}">
            <view class="profile-type-badge" style="background: {{myGroupInfo.color}};">
              <text class="profile-type-text">{{myType}}</text>
            </view>
            <text class="profile-type-name">{{myTypeInfo.name}}</text>
          </view>
          <text class="profile-test-hint" wx:else bindtap="goTest">还没测定？点击开始 →</text>
        </view>
        <view class="profile-edit icon-edit"></view>
      </view>

      <!-- 统计 -->
      <view class="profile-stats">
        <view class="stat-item">
          <text class="stat-num">{{stats.assessmentCount}}</text>
          <text class="stat-label">测定次数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{stats.matchCount}}</text>
          <text class="stat-label">关系对比</text>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <view class="quick-btn" bindtap="goResult" wx:if="{{myType}}">
        <view class="quick-icon icon-result"></view>
        <text class="quick-text">测定结果</text>
      </view>
      <view class="quick-btn" bindtap="goTest">
        <view class="quick-icon icon-chat"></view>
        <text class="quick-text">{{myType ? '重新测定' : '开始测定'}}</text>
      </view>
      <view class="quick-btn" bindtap="goRelationGraph" wx:if="{{myType}}">
        <view class="quick-icon icon-graph"></view>
        <text class="quick-text">关系星图</text>
      </view>
      <button class="quick-btn share-btn" open-type="share">
        <view class="quick-icon icon-share"></view>
        <text class="quick-text">分享</text>
      </button>
    </view>

    <!-- 测定历史 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">测定记录</text>
      </view>
      
      <view class="history-list" wx:if="{{assessmentHistory.length > 0}}">
        <view class="history-item" wx:for="{{assessmentHistory}}" wx:key="id" bindtap="goResultDetail" data-id="{{item.id}}">
          <view class="history-left">
            <text class="history-type">{{item.mbtiType}}</text>
            <text class="history-date">{{item.date}}</text>
          </view>
          <view class="history-right">
            <text class="history-confidence">置信度 {{item.confidence}}%</text>
            <view class="history-arrow"></view>
          </view>
        </view>
      </view>

      <view class="empty-state" wx:else>
        <text class="empty-icon">○</text>
        <text class="empty-text">还没有测定记录</text>
        <text class="empty-action" bindtap="goTest">开始第一次测定 →</text>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">关于</text>
      </view>
      <view class="about-item" bindtap="goPrivacy">
        <text class="about-text">隐私协议</text>
        <view class="about-arrow"></view>
      </view>
      <view class="about-item">
        <text class="about-text">版本</text>
        <text class="about-value">1.0.0</text>
      </view>
    </view>

    <view class="bottom-pad"></view>
  </view>
</view>
