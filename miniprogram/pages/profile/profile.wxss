/* pages/profile/profile.wxss */
.page { min-height: 100vh; background: #f8f6f3; }

.custom-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(248,246,243,0.95); backdrop-filter: blur(10px);
}
.nav-content { display: flex; align-items: center; justify-content: center; padding: 0 24rpx; }
.nav-title { font-size: 34rpx; font-weight: 600; color: #1a1a2e; }
.content { padding: 0 32rpx; }

/* 用户卡片 */
.profile-card {
  background: #fff; border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04); margin-bottom: 24rpx;
}
.profile-main {
  display: flex; align-items: center; padding: 32rpx;
}
.profile-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%; margin-right: 24rpx;
  background: #f0ebe5;
}
.profile-info { flex: 1; }
.profile-name { font-size: 34rpx; font-weight: 600; color: #1a1a2e; }
.profile-type-row { display: flex; align-items: center; margin-top: 8rpx; }
.profile-type-badge {
  padding: 4rpx 16rpx; border-radius: 8rpx; margin-right: 12rpx;
}
.profile-type-text { font-size: 24rpx; color: #fff; font-weight: 500; }
.profile-type-name { font-size: 24rpx; color: #64748b; }
.profile-test-hint { font-size: 26rpx; color: #6366f1; margin-top: 8rpx; }
.profile-edit { width: 40rpx; height: 40rpx; opacity: 0.3; }

/* 统计 */
.profile-stats {
  display: flex; border-top: 1rpx solid #f0ebe5;
}
.stat-item { flex: 1; padding: 24rpx; text-align: center; }
.stat-num { display: block; font-size: 36rpx; font-weight: 700; color: #1a1a2e; }
.stat-label { font-size: 24rpx; color: #94a3b8; margin-top: 4rpx; }
.stat-divider { width: 1rpx; background: #f0ebe5; }

/* 快捷操作 */
.quick-actions {
  display: flex; gap: 16rpx; margin-bottom: 32rpx;
}
.quick-btn {
  flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx 0;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
}
.quick-btn::after { border: none; }
.quick-icon { width: 56rpx; height: 56rpx; border-radius: 14rpx; background: #f0ebe5; }
.icon-result { background: linear-gradient(135deg, #6366f1, #818cf8); }
.icon-chat { background: linear-gradient(135deg, #10b981, #34d399); }
.icon-graph { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.icon-share { background: linear-gradient(135deg, #ec4899, #f472b6); }
.quick-text { font-size: 24rpx; color: #64748b; }

/* 区域 */
.section { margin-bottom: 32rpx; }
.section-header { margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #1a1a2e; }

/* 测定历史 */
.history-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 16rpx; padding: 28rpx 32rpx;
  margin-bottom: 12rpx;
}
.history-left { display: flex; align-items: center; gap: 16rpx; }
.history-type { font-size: 32rpx; font-weight: 700; color: #6366f1; }
.history-date { font-size: 24rpx; color: #94a3b8; }
.history-right { display: flex; align-items: center; gap: 12rpx; }
.history-confidence { font-size: 24rpx; color: #64748b; }
.history-arrow {
  width: 14rpx; height: 14rpx; border-right: 3rpx solid #c4b5a8;
  border-top: 3rpx solid #c4b5a8; transform: rotate(45deg);
}

/* 空状态 */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 64rpx 0; gap: 12rpx;
}
.empty-icon { font-size: 64rpx; color: #d4cfc7; }
.empty-text { font-size: 28rpx; color: #94a3b8; }
.empty-action { font-size: 28rpx; color: #6366f1; font-weight: 500; }

/* 关于 */
.about-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-radius: 16rpx; padding: 28rpx 32rpx;
  margin-bottom: 12rpx;
}
.about-text { font-size: 28rpx; color: #1a1a2e; }
.about-value { font-size: 26rpx; color: #94a3b8; }
.about-arrow {
  width: 14rpx; height: 14rpx; border-right: 3rpx solid #c4b5a8;
  border-top: 3rpx solid #c4b5a8; transform: rotate(45deg);
}

.bottom-pad { height: 120rpx; }
