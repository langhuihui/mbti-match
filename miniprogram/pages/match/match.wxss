/* 匹配页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1e1b4b 0%, #312e81 200rpx, var(--bg) 450rpx);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 64rpx;
}

.content {
  padding: 0 32rpx 120rpx;
}

/* ====== 邀请者卡片 ====== */
.inviter-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 32rpx;
}

.inviter-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.inviter-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}

.inviter-avatar.real-avatar {
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.inviter-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.inviter-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 2rpx;
}

.inviter-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}

.inviter-type-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.inviter-type {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.inviter-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.inviter-badge {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

.inviter-badge-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.inviter-prompt {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 20rpx;
}

/* ====== 我的选择区 ====== */
.my-select-area {
  margin-bottom: 24rpx;
}

.my-type-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.my-preview-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 18rpx;
  background: #f1f5f9;
}

.my-preview-img.real-avatar {
  border-radius: 50%;
  border: 3rpx solid var(--primary);
}

.my-preview-info {
  display: flex;
  flex-direction: column;
}

.my-preview-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.my-preview-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.my-preview-type {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.my-preview-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 方法切换和选择器（复用 test 页的样式） */
.method-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.method-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.method-tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.switch-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.switch-label-l,
.switch-label-r {
  font-size: 26rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  width: 130rpx;
}

.switch-label-l { text-align: right; }
.switch-label-r { text-align: left; }

.switch-label-l.active,
.switch-label-r.active {
  color: var(--primary);
  font-weight: 700;
}

.custom-switch {
  width: 108rpx;
  height: 60rpx;
  border-radius: 30rpx;
  position: relative;
  margin: 0 16rpx;
}

.switch-track {
  position: absolute;
  inset: 0;
  border-radius: 30rpx;
  background: #e2e8f0;
  transition: background 0.3s;
}

.custom-switch.on .switch-track {
  background: var(--primary);
}

.switch-thumb {
  position: absolute;
  width: 52rpx;
  height: 52rpx;
  background: #fff;
  border-radius: 26rpx;
  top: 4rpx;
  left: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.3s;
  z-index: 1;
}

.custom-switch.on .switch-thumb {
  transform: translateX(48rpx);
}

.thumb-letter {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 52rpx;
  height: 52rpx;
  width: 52rpx;
  text-align: center;
  display: block;
}

.grid-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grid-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.grid-group-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.grid-group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.grid-types {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 10rpx;
}

.grid-type-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  background: #f8fafc;
}

.grid-type-btn.selected {
  transform: scale(1.02);
}

.grid-type-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  margin-bottom: 6rpx;
}

.grid-type-code {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.grid-type-name {
  font-size: 18rpx;
  color: var(--text-secondary);
}

/* ====== 揭晓按钮 ====== */
.btn-reveal {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 8rpx 40rpx rgba(139, 92, 246, 0.4);
  letter-spacing: 4rpx;
}

.btn-reveal::after {
  border: none;
}

.btn-reveal-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.6);
}

/* ====== 揭晓阶段 ====== */
.reveal-stage {
  padding-top: 20rpx;
}

.reveal-stage.animate .reveal-vs {
  animation: fadeIn 0.6s ease;
}

.reveal-vs {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 0 40rpx;
  position: relative;
}

.reveal-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

/* 悬念阶段：两人向中心靠拢一点 */
.phase-loading .reveal-person.side-left { transform: translateX(20rpx); }
.phase-loading .reveal-person.side-right { transform: translateX(-20rpx); }
/* 揭晓后恢复原位 */
.phase-shown .reveal-person { transform: translateX(0); }

.reveal-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 2;
}

.reveal-avatar.real-avatar {
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.reveal-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头像外圈光环：悬念阶段旋转 */
.reveal-ring {
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(255, 255, 255, 0.35);
  opacity: 0;
  z-index: 1;
}
.phase-loading .reveal-ring {
  opacity: 1;
  animation: ringSpin 3s linear infinite;
}

@keyframes ringSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.reveal-nickname {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 4rpx;
}

.reveal-type {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.reveal-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.reveal-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.1);
  padding: 4rpx 20rpx;
  border-radius: 100rpx;
}

.reveal-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

/* 两侧连接光束（悬念时呼吸） */
.reveal-beam {
  position: absolute;
  left: -180rpx;
  right: -180rpx;
  top: 50%;
  height: 2rpx;
  margin-top: -1rpx;
  background: linear-gradient(90deg,
    transparent 0%,
    rgba(139, 92, 246, 0.1) 15%,
    rgba(236, 72, 153, 0.8) 50%,
    rgba(139, 92, 246, 0.1) 85%,
    transparent 100%);
  opacity: 0;
  transition: opacity 0.3s;
}
.phase-loading .reveal-beam {
  opacity: 1;
  animation: beamPulse 1s ease-in-out infinite;
}
.phase-revealing .reveal-beam,
.phase-shown .reveal-beam {
  opacity: 0.5;
}

@keyframes beamPulse {
  0%, 100% { opacity: 0.3; transform: scaleX(0.6); }
  50% { opacity: 1; transform: scaleX(1); }
}

/* 三层脉冲光晕 */
.reveal-pulse {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(139, 92, 246, 0.35);
  opacity: 0;
}
.phase-loading .reveal-pulse {
  animation: pulseRipple 1.6s ease-out infinite;
}
.phase-loading .reveal-pulse.pulse-2 { animation-delay: 0.4s; }
.phase-loading .reveal-pulse.pulse-3 { animation-delay: 0.8s; }

/* 揭晓阶段变为绽放 */
.phase-revealing .reveal-pulse,
.phase-shown .reveal-pulse {
  animation: pulseBloom 0.8s ease-out forwards;
  background: rgba(236, 72, 153, 0.35);
}

@keyframes pulseRipple {
  0% { transform: scale(0.6); opacity: 0.8; }
  100% { transform: scale(2.4); opacity: 0; }
}

@keyframes pulseBloom {
  0% { transform: scale(0.4); opacity: 0.9; }
  100% { transform: scale(3.2); opacity: 0; }
}

/* 中心芯（承载 emoji 或问号） */
.reveal-core {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
  transition: transform 0.3s;
}
.phase-revealing .reveal-core {
  animation: coreFlip 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}
.phase-shown .reveal-core {
  transform: scale(1.1);
}

@keyframes coreFlip {
  0% { transform: rotateY(0deg) scale(1); }
  50% { transform: rotateY(90deg) scale(1.3); }
  100% { transform: rotateY(0deg) scale(1.1); }
}

.reveal-emoji {
  font-size: 44rpx;
  animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.reveal-loading {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

@keyframes popIn {
  from { transform: scale(0); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 关系结果 */
.reveal-result {
  text-align: center;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.6s ease;
}

.reveal-result.show {
  opacity: 1;
  transform: translateY(0);
}

/* 徽章 3D 翻转入场 */
.result-badge-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
  perspective: 800rpx;
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 48rpx;
  border-radius: 100rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: badgeFlipIn 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  transform-origin: center;
}

.result-badge-wrap.settled .result-badge {
  animation: badgeBreathe 2.4s ease-in-out infinite;
}

@keyframes badgeFlipIn {
  0% { transform: rotateY(-180deg) scale(0.4); opacity: 0; }
  60% { transform: rotateY(20deg) scale(1.08); opacity: 1; }
  100% { transform: rotateY(0deg) scale(1); }
}

@keyframes badgeBreathe {
  0%, 100% { transform: scale(1); box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15); }
  50% { transform: scale(1.03); box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.22); }
}

.result-emoji {
  font-size: 40rpx;
}

.result-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.result-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.result-stars {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.result-star {
  font-size: 32rpx;
  color: #e2e8f0;
  transform: scale(1);
  transition: transform 0.2s ease, color 0.2s ease, text-shadow 0.2s ease;
}

.result-star.filled {
  color: #fbbf24;
}

.result-star.lit {
  animation: starPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  text-shadow: 0 0 20rpx rgba(251, 191, 36, 0.75);
}

@keyframes starPop {
  0% { transform: scale(0.4) rotate(-30deg); opacity: 0.2; }
  60% { transform: scale(1.4) rotate(8deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

.result-desc {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
}

.result-brief {
  background: linear-gradient(135deg, #eef2ff, #faf5ff);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(99, 102, 241, 0.12);
}

.result-brief-label {
  display: block;
  font-size: 22rpx;
  color: #6366f1;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.result-brief-text {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.6;
  font-weight: 500;
}

.result-brief-tip {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 12rpx;
}

.result-detail {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

/* 操作按钮 */
.quick-test-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0 8rpx;
  padding: 20rpx;
}

.quick-test-icon {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.quick-test-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-decoration: underline;
}

.action-area {
  margin-top: 24rpx;
}

.btn-detail {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(99, 102, 241, 0.35);
  margin-bottom: 20rpx;
}

.btn-detail::after {
  border: none;
}

.btn-row {
  display: flex;
  gap: 12rpx;
}

.btn-sub {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 38rpx;
  border: 2rpx solid var(--primary);
}

.btn-sub::after {
  border: none;
}

/* ====== 生成对比海报 ====== */
.btn-poster {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #f472b6 0%, #8b5cf6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 36rpx rgba(139, 92, 246, 0.35);
}

.btn-poster::after {
  border: none;
}

/* 离屏 canvas：不可见，但需要保持在渲染树中 */
.poster-canvas-offscreen {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 720rpx;
  height: 1080rpx;
  pointer-events: none;
  opacity: 0;
}

/* 海报预览弹层 */
.poster-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.78);
  z-index: 9998;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.poster-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.poster-dialog {
  width: 100%;
  max-width: 620rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: posterPop 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes posterPop {
  0% { opacity: 0; transform: translateY(30rpx) scale(0.92); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.poster-preview {
  width: 100%;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.45);
  background: rgba(255, 255, 255, 0.06);
}

.poster-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  width: 100%;
}

.poster-btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
}

.poster-btn::after { border: none; }

.poster-btn.secondary {
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.poster-btn.primary {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #fff;
}

.poster-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 匹配后微记录 */
.micro-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.micro-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.micro-dialog {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.micro-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.micro-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin: 12rpx 0 24rpx;
  line-height: 1.5;
}

.micro-input {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #334155;
  box-sizing: border-box;
}

.micro-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.micro-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.micro-btn {
  flex: 1;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx;
  border: none;
}

.micro-btn.skip {
  background: #f1f5f9;
  color: #64748b;
}

.micro-btn.submit {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-weight: 600;
}
