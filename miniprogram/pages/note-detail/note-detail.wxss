/* 笔记详情页样式 */
.page {
  min-height: 100vh;
  background: #fff;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.nav-content {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
}

.nav-back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--text-primary);
  border-bottom: 4rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.nav-share-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
}

.nav-share-btn::after {
  border: none;
}

.share-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
}

.content {
  height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ====== 未找到 ====== */
.not-found {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.not-found-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.not-found-text {
  font-size: 30rpx;
  color: var(--text-tertiary);
  margin-bottom: 32rpx;
}

.not-found-btn {
  padding: 16rpx 48rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 100rpx;
  border: none;
}

.not-found-btn::after {
  border: none;
}

/* ====== 作者信息 ====== */
.author-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.author-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f1f5f9;
  flex-shrink: 0;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.author-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.author-mbti {
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.mbti-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.author-type-name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.note-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* ====== 笔记正文 ====== */
.note-content {
  padding: 32rpx;
}

.note-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.note-body {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
}

.moment-match {
  margin: 0 32rpx 16rpx;
  padding: 10rpx 20rpx;
  background: #eef2ff;
  border-radius: 999rpx;
  display: inline-block;
}

.moment-match text {
  font-size: 24rpx;
  color: #6366f1;
  font-weight: 500;
}

.micro-body {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.7;
}

/* ====== 图片 ====== */
.note-images {
  padding: 0 32rpx;
}

.note-img {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

/* ====== 标签 ====== */
.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 24rpx 32rpx;
}

.note-tag {
  font-size: 26rpx;
  color: var(--primary);
  background: rgba(99, 102, 241, 0.06);
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
}

/* ====== 互动数据 ====== */
.note-stats {
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

.stat-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ====== 互动操作栏 ====== */
.interaction-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
}

.interact-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
}

.interact-btn.active {
  background: rgba(99, 102, 241, 0.06);
}

.share-btn-wrap {
  background: transparent;
  border: none;
  line-height: normal;
  margin: 0;
  font-size: inherit;
}

.share-btn-wrap::after {
  border: none;
}

.interact-icon {
  font-size: 28rpx;
}

.interact-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.interact-btn.active .interact-text {
  color: var(--primary);
}

/* ====== 评论区 ====== */
.comments-section {
  padding: 32rpx;
}

.comments-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f1f5f9;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.comment-mbti {
  padding: 2rpx 10rpx;
  border-radius: 100rpx;
}

.comment-mbti-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
}

.comment-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: auto;
}

.comment-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.no-comments {
  text-align: center;
  padding: 48rpx 0;
}

.no-comments-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* ====== 底部评论栏 ====== */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.comment-trigger {
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #f1f5f9;
  border-radius: 36rpx;
}

.comment-placeholder {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.comment-input-area {
  display: flex;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f1f5f9;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.comment-send {
  width: 120rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e2e8f0;
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  border: none;
  padding: 0;
  line-height: normal;
}

.comment-send::after {
  border: none;
}

.comment-send.active {
  background: var(--primary);
  color: #fff;
}
