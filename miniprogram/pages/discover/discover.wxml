<view class="page">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{headerHeight - statusBarHeight}}px;">
      <text class="nav-title">发现</text>
    </view>
  </view>

  <view class="content" style="padding-top: {{headerHeight}}px;">
    <!-- 话题标签栏 -->
    <scroll-view class="topic-bar" scroll-x enable-flex>
      <view
        class="topic-item {{currentTopic === item.key ? 'active' : ''}}"
        wx:for="{{topics}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTopicChange"
      >
        <text class="topic-icon" wx:if="{{item.key !== 'all'}}">{{item.icon}}</text>
        <text class="topic-name">{{item.name}}</text>
      </view>

      <view
        class="topic-item filter-btn {{currentMbtiFilter ? 'active' : ''}}"
        wx:if="{{!isMomentTab && !isFeaturedTab}}"
        bindtap="toggleTypeFilter"
      >
        <text class="topic-name">{{currentMbtiFilter || '类型'}}</text>
        <view class="filter-arrow {{showTypeFilter ? 'up' : ''}}"></view>
      </view>
    </scroll-view>

    <!-- 策展说明 -->
    <view class="feed-hint" wx:if="{{isMomentTab}}">
      <text>匹配后一句话记录，比写长文更轻松</text>
    </view>
    <view class="feed-hint featured" wx:if="{{isFeaturedTab}}">
      <text>编辑精选 · 帮你入门 MBTI 关系思考</text>
    </view>

    <!-- MBTI类型筛选面板 -->
    <view class="type-filter-panel {{showTypeFilter ? 'show' : ''}}" wx:if="{{!isMomentTab && !isFeaturedTab}}">
      <view class="filter-panel-mask" bindtap="toggleTypeFilter"></view>
      <view class="filter-panel-content">
        <view class="filter-header">
          <text class="filter-title">按MBTI类型筛选</text>
          <text class="filter-clear" wx:if="{{currentMbtiFilter}}" bindtap="clearMbtiFilter">清除</text>
        </view>
        <view class="filter-group" wx:for="{{mbtiGroups}}" wx:key="key">
          <text class="filter-group-name" style="color: {{item.color}};">{{item.name}}</text>
          <view class="filter-types">
            <view
              class="filter-type-chip {{currentMbtiFilter === type ? 'active' : ''}}"
              wx:for="{{item.types}}"
              wx:for-item="type"
              wx:key="*this"
              data-type="{{type}}"
              bindtap="onMbtiFilter"
              style="{{currentMbtiFilter === type ? 'background:' + item.color + ';color:#fff;' : ''}}"
            >
              <text>{{type}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 内容列表 -->
    <view class="notes-list" wx:if="{{!isEmpty}}">
      <view
        class="note-card {{item.isMicro ? 'micro-card' : ''}}"
        wx:for="{{notes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onNoteTap"
      >
        <!-- 精选角标 -->
        <view class="featured-badge" wx:if="{{item.isFeatured}}">精选</view>

        <view class="note-author">
          <image
            class="author-avatar"
            src="{{item.author.avatarUrl || '/images/default-avatar.svg'}}"
            mode="aspectFill"
          />
          <view class="author-info">
            <text class="author-name">{{item.author.nickname}}</text>
            <view class="author-mbti" wx:if="{{item.groupInfo}}" style="background: {{item.groupInfo.color}};">
              <text class="mbti-badge-text">{{item.author.mbtiType}}</text>
            </view>
          </view>
          <text class="note-time">{{item.timeText}}</text>
        </view>

        <!-- 关系瞬间：匹配标签 -->
        <view class="moment-match" wx:if="{{item.isMicro && item.matchLabel}}">
          <text>{{item.matchLabel}}</text>
        </view>

        <view class="note-body">
          <text class="note-title" wx:if="{{item.title && !item.isMicro}}">{{item.title}}</text>
          <text class="note-text {{item.isMicro ? 'micro-text' : ''}}">{{item.contentPreview}}</text>
        </view>

        <view class="note-images" wx:if="{{item.images.length > 0 && !item.isMicro}}">
          <image
            class="note-img {{item.images.length === 1 ? 'single' : ''}}"
            wx:for="{{item.images}}"
            wx:for-item="img"
            wx:key="*this"
            src="{{img}}"
            mode="aspectFill"
          />
        </view>

        <view class="note-tags" wx:if="{{item.tags.length > 0 && !item.isMicro}}">
          <text class="note-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
        </view>

        <view class="note-actions">
          <view class="action-item {{item.isLiked ? 'liked' : ''}}" catchtap="onLikeTap" data-id="{{item.id}}" data-index="{{index}}">
            <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likes || ''}}</text>
          </view>
          <view class="action-item" wx:if="{{!item.isMicro}}">
            <text class="action-icon">💬</text>
            <text class="action-count">{{item.comments || ''}}</text>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{loading}}">
        <text class="load-text">加载中...</text>
      </view>
      <view class="load-more" wx:elif="{{!hasMore}}">
        <text class="load-text">— 已经到底了 —</text>
      </view>
    </view>

    <!-- 关系瞬间空状态 -->
    <view class="empty-state" wx:if="{{isEmpty && !loading && isMomentTab}}">
      <text class="empty-emoji">💫</text>
      <text class="empty-title">还没有关系瞬间</text>
      <text class="empty-desc">完成一次好友匹配，用一句话记录你们的化学反应</text>
      <button class="empty-btn" bindtap="goMatch">去邀请好友匹配</button>
      <text class="empty-link" bindtap="goFeatured">先看看精选内容 →</text>
    </view>

    <!-- 其他空状态 -->
    <view class="empty-state" wx:elif="{{isEmpty && !loading}}">
      <text class="empty-emoji">📚</text>
      <text class="empty-title">暂无内容</text>
      <text class="empty-desc">{{currentMbtiFilter ? '该类型暂无内容，换个筛选试试' : '换个话题看看吧'}}</text>
    </view>
  </view>
</view>
