/* 发现页样式 */
.page {
  min-height: 100vh;
  background: var(--bg);
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nav-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.feed-hint {
  padding: 16rpx 32rpx 0;
  font-size: 24rpx;
  color: #64748b;
}

.feed-hint.featured {
  color: #6366f1;
}

.featured-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.moment-match {
  margin: 0 24rpx 12rpx;
  padding: 8rpx 16rpx;
  background: #eef2ff;
  border-radius: 999rpx;
  display: inline-block;
}

.moment-match text {
  font-size: 22rpx;
  color: #6366f1;
  font-weight: 500;
}

.micro-card {
  border-left: 6rpx solid #6366f1;
}

.micro-text {
  font-size: 30rpx !important;
  line-height: 1.6 !important;
  color: #334155 !important;
  font-weight: 500;
}

.empty-link {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #6366f1;
}

.nav-right {
  display: flex;
  gap: 16rpx;
}

.nav-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--text-secondary);
  border-radius: 50%;
  position: relative;
}

.search-icon::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 10rpx;
  height: 3rpx;
  background: var(--text-secondary);
  transform: rotate(45deg);
}

.content {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ====== 话题标签栏 ====== */
.topic-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
}

.topic-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.topic-item.active {
  background: var(--primary);
}

.topic-item.active .topic-name {
  color: #fff;
}

.topic-icon {
  font-size: 24rpx;
}

.topic-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.filter-btn {
  border: 2rpx solid var(--border);
  background: #fff;
}

.filter-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--text-tertiary);
  margin-left: 4rpx;
  transition: transform 0.2s;
}

.filter-arrow.up {
  transform: rotate(180deg);
}

/* ====== 类型筛选面板 ====== */
.type-filter-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.type-filter-panel.show {
  visibility: visible;
  opacity: 1;
}

.filter-panel-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
}

.filter-panel-content {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 0 0 32rpx 32rpx;
  padding: 32rpx;
  padding-top: calc(32rpx + env(safe-area-inset-top) + 88rpx);
  transform: translateY(-100%);
  transition: transform 0.3s ease;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.type-filter-panel.show .filter-panel-content {
  transform: translateY(0);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-clear {
  font-size: 26rpx;
  color: var(--primary);
}

.filter-group {
  margin-bottom: 20rpx;
}

.filter-group-name {
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: block;
}

.filter-types {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-type-chip {
  padding: 10rpx 24rpx;
  border-radius: 100rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-type-chip.active {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* ====== 笔记卡片 ====== */
.notes-list {
  padding: 16rpx 24rpx;
}

.note-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 作者信息 */
.note-author {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1f5f9;
  flex-shrink: 0;
}

.author-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.author-mbti {
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
}

.mbti-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.note-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  flex-shrink: 0;
}

/* 笔记内容 */
.note-body {
  margin-bottom: 16rpx;
}

.note-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.note-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 图片 */
.note-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.note-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.note-img.single {
  width: 400rpx;
  height: 300rpx;
}

/* 标签 */
.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.note-tag {
  font-size: 24rpx;
  color: var(--primary);
  background: rgba(99, 102, 241, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

/* 互动栏 */
.note-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 28rpx;
}

.action-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  min-width: 24rpx;
}

.action-item.liked .action-count {
  color: #ef4444;
}

/* ====== 加载更多 ====== */
.load-more {
  text-align: center;
  padding: 32rpx 0;
}

.load-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 100rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.empty-btn::after {
  border: none;
}
