# 后台管理系统环境变量配置
# 复制此文件为 .env 并填写真实值

# 数据模式：
#   mock  - 纯前端假数据（开发用）
#   cloud - 仅使用云函数调用（失败即报错）
#   auto  - 优先云函数，失败降级 mock（推荐）
VITE_DATA_MODE=auto

# 微信云开发环境 ID（同小程序 config/cloud.js 中的 CLOUD_ENV_ID）
VITE_CLOUD_ENV_ID=cloud1-7gp43sck0ad2f04a

# 管理员 token（需与云函数 admin-api 环境变量 ADMIN_TOKEN 一致）
VITE_ADMIN_TOKEN=your_admin_token_here
